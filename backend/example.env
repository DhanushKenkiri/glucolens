# GlucoLens backend configuration.
# Copy this file to .env (same folder) and fill in GROQ_API_KEY.
# Real environment variables take precedence over values in .env.

# --- Assistant (Ask tab) ------------------------------------------------------
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq chat model that supports tool use.
# openai/gpt-oss-120b is the strongest; openai/gpt-oss-20b is faster and lighter
# on rate limits; llama-3.3-70b-versatile also works.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Reasoning effort for reasoning models (gpt-oss): low | medium | high.
# Leave it empty for models without reasoning, such as llama-3.3-70b-versatile.
GROQ_REASONING_EFFORT=low

# --- Server -------------------------------------------------------------------
PORT=8080
# Comma-separated browser origins allowed to call the API (the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Folder with the built frontend (npm run build). Served at / when it exists.
STATIC_DIR=../frontend/dist

# --- Data ---------------------------------------------------------------------
# The CSV is converted once into DATASET_JSON; the app reads only the JSON.
# Replacing the CSV triggers a fresh conversion on the next start.
DATASET_CSV=data/diabetes_dataset.csv
DATASET_JSON=data/dataset.json
